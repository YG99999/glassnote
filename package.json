{
  "name": "glassnote",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "tsc --noEmit && vite build",
    "tauri": "tauri",
    "app:dev": "powershell -NoProfile -File scripts/run.ps1 dev",
    "app:build": "powershell -NoProfile -File scripts/run.ps1 build",
    "test:rust": "powershell -NoProfile -File scripts/run.ps1 test",
    "test:ui": "node tests/library.mjs && node tests/overlay.mjs && node tests/selection.mjs",
    "lint:rust": "powershell -NoProfile -File scripts/run.ps1 lint"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.9.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.9.0",
    "playwright": "1.64.1",
    "typescript": "~5.9.3",
    "vite": "^7.1.12"
  },
  "description": "Windows screenshots with offline voice notes and numbered annotations",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/YG99999/glassnote.git"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
